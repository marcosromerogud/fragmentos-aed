<script>
(function () {
  // Selector: se arma con textContent (a prueba de XSS) y navega al elegir
  var sel = document.getElementById("frgId");
  var actual = sel.getAttribute("data-sel") || "";
  var lista = (sel.getAttribute("data-frags") || "").split(",");
  var vacio = document.createElement("option");
  vacio.value = "";
  sel.appendChild(vacio);
  for (var i = 0; i < lista.length; i++) {
    if (!lista[i]) continue;
    var p = lista[i].split("|");
    var o = document.createElement("option");
    o.value = decodeURIComponent(p[0]);
    o.textContent = decodeURIComponent(p[1] || "");
    if (o.value === actual) o.selected = true;
    sel.appendChild(o);
  }
  sel.onchange = function () {
    if (sel.value) location.href = location.pathname + "?frgId=" + encodeURIComponent(sel.value);
  };

  // Preview
  var v = document.getElementById("vista");
  if (!v) return;
  var html = decodeURIComponent(v.getAttribute("data-html") || "");
  v.srcdoc = html;

  var bE = document.getElementById("escritorio");
  var bM = document.getElementById("movil");
  var bD = document.getElementById("descargar");
  function ancho(n) {
    v.setAttribute("width", n);
    bE.setAttribute("data-activo", n === 700 ? "si" : "no");
    bM.setAttribute("data-activo", n === 375 ? "si" : "no");
  }
  bE.onclick = function () { ancho(700); };
  bM.onclick = function () { ancho(375); };
  bD.onclick = function () {
    var url = URL.createObjectURL(new Blob([html], { type: "text/html" }));
    var a = document.createElement("a");
    a.href = url;
    a.download = "template-" + (v.getAttribute("data-id") || "preview") + ".html";
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(function () { URL.revokeObjectURL(url); }, 5000);
  };
})();
</script>


