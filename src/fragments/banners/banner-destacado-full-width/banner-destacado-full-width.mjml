<mjml>
  <mj-head>
    <mj-include path="@partials/fonts.mjml" />
    <mj-include path="@partials/colors.mjml" />
    <!-- Mobile hasta 599px, como la referencia. MJML emite el corte de
         desktop en (breakpoint) y el de mobile en (breakpoint - 1). -->
    <mj-breakpoint width="600px" />
    <mj-style>
      @media only screen and (max-width:599px) {
        .banner-destacado-full-width-icono { width: 112px !important; }
        .banner-destacado-full-width-texto { width: calc(100% - 112px) !important; }
        .banner-destacado-full-width-icono-img { padding: 12px 12px 12px 12px !important; }
        .banner-destacado-full-width-icono-img img {
          width: 64px !important;
          height: auto !important;
        }
        /* La tabla interna de mj-image conserva los 100px del desktop y
           descentra el ícono; se la achica al tamaño de mobile. */
        .banner-destacado-full-width-icono-img td { width: 64px !important; }
        .banner-destacado-full-width-titulo { padding: 12px 12px 8px 0px !important; }
        .banner-destacado-full-width-cuerpo { padding: 0px 12px 12px 0px !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body mj-class="bg-gris-claro" width="600px">
    <!-- Sin laterales: la caja ocupa los 600px completos. -->
      <mj-section
        mj-class="bg-celeste-claro"
        border-radius="0px"
        padding="0px"
        text-align="left"
      >
        <!-- mj-group: el ícono y el texto siguen en fila en mobile, como la
             referencia. Los anchos de columna van en px explícitos porque
             dentro de un grupo MJML reparte 50/50 al que no lo declara. -->
        <mj-group>
          <!-- 124px = los 104px que declara la celda de la referencia + sus 20px
               de padding izquierdo. Medido sobre la referencia en el navegador. -->
          <mj-column
            css-class="banner-destacado-full-width-icono"
            width="124px"
            padding="0px"
            vertical-align="middle"
          >
            <mj-image
              css-class="banner-destacado-full-width-icono-img"
              src="https://bcp-mid-stage13-res.adobe-campaign.com/res/tracking/f2d9855c0b2c1f83f4228ab86be22acb.png"
              alt="icono"
              width="100px"
              align="center"
              padding="16px 0px 16px 20px"
            />
          </mj-column>
          <mj-column
            css-class="banner-destacado-full-width-texto"
            width="476px"
            padding="0px"
            vertical-align="middle"
          >
            <mj-text
              mj-class="txt-azul"
              css-class="banner-destacado-full-width-titulo"
              align="left"
              font-family="Flexo, Arial, Helvetica, sans-serif"
              font-weight="700"
              font-size="20px"
              line-height="28px"
              padding="16px 20px 8px 12px"
            >
              Participa por 1 Kit Apple
            </mj-text>
            <mj-text
              mj-class="txt-azul-oscuro"
              css-class="banner-destacado-full-width-cuerpo"
              align="left"
              font-family="Flexo, Arial, Helvetica, sans-serif"
              font-weight="400"
              font-size="16px"
              line-height="24px"
              padding="0px 20px 16px 12px"
            >
              Recuerda que también puedes solicitar tu tarjeta desde la<span style="font-weight: 700"> App Banca Móvil BCP</span> en la sección <span style="font-weight: 700">Para Ti.</span>
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
  </mj-body>
</mjml>
