<mjml>
  <mj-head>
    <mj-include path="@partials/fonts.mjml" />
    <mj-include path="@partials/colors.mjml" />
    <!-- Mobile hasta 599px, como la referencia. MJML emite el corte de
         desktop en (breakpoint) y el de mobile en (breakpoint - 1). -->
    <mj-breakpoint width="600px" />
    <!-- Mejora visual para compactar el bloque en mobile; no es un requisito:
         el layout base ya funciona sin este <mj-style>. -->
    <mj-style>
      @media only screen and (max-width:599px) {
        .banner-destacado-full-width-icono {
          width: 94px !important;
          padding-left: 18px !important;
        }
        .banner-destacado-full-width-icono img {
          width: 64px !important;
          height: auto !important;
        }
        .banner-destacado-full-width-texto { padding: 12px 26px 12px 12px !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body mj-class="bg-gris-claro" width="600px">
    <!-- Sin wrapper ni laterales: la caja ocupa los 600px completos. El radio
         queda en el mj-section, que envuelve todo el bloque, y es 0px porque
         esta variante llega hasta los bordes. -->
    <mj-section
      mj-class="bg-celeste-claro"
      border-radius="0px"
      padding="0px"
      text-align="left"
    >
      <mj-column width="100%" padding="0px">
        <!-- Se usa mj-table para dejar fija la celda del ícono y fluida la
             del texto: así la fila sobrevive aunque AED elimine todos los
             <style> al romper (desvincular) el fragmento. Con mj-group y
             columnas, MJML compilaba anchos porcentuales fijos inline que
             no reflujaban. -->
        <!-- 142px = 30px visibles desde el borde izquierdo hasta la imagen +
             100px de imagen + 12px de hueco hasta la celda de texto. -->
        <!-- En mobile la celda pasa a 94px: 18px hasta la imagen + 64px de
             imagen + el mismo hueco de 12px hasta la celda de texto. -->
        <!-- Los 26px de padding derecho dejan 26px visibles hasta el borde
             de esta caja, que no lleva borde propio. A la izquierda se
             mantienen 12px para conservar el hueco con el ícono. -->
        <!-- mj-table aplica un solo mj-class de color a toda la tabla y no
             procesa mj-class dentro de su HTML crudo. El cuerpo toma el color
             de la tabla y el título lo sobrescribe con el hex inline #002A8D.
             Ver docs/convenciones-mjml.md, "Excepción acotada: título dentro
             de mj-table". -->
        <mj-table
          mj-class="txt-azul-oscuro"
          font-family="Flexo, Arial, Helvetica, sans-serif"
          font-size="16px"
          line-height="24px"
          padding="0px"
          width="100%"
          role="presentation"
        >
          <tr>
            <td
              class="banner-destacado-full-width-icono"
              width="142"
              valign="middle"
              align="left"
              style="width: 142px; padding-left: 30px"
            >
              <img
                src="https://bcp-mid-stage13-res.adobe-campaign.com/res/tracking/f2d9855c0b2c1f83f4228ab86be22acb.png"
                alt="icono"
                width="100"
                style="display: block; border: 0; width: 100px; height: auto"
              />
            </td>
            <td
              class="banner-destacado-full-width-texto"
              valign="middle"
              style="padding: 16px 26px 16px 12px; word-break: normal; overflow-wrap: break-word; white-space: normal; hyphens: none"
            >
              <p style="color:#002A8D;font-size:20px;line-height:28px;font-weight:700;margin:0px 0px 8px">Participa por 1 Kit Apple</p>
              Recuerda que también puedes solicitar tu tarjeta desde la<span style="font-weight: 700"> App Banca Móvil BCP</span> en la sección <span style="font-weight: 700">Para Ti.</span>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
