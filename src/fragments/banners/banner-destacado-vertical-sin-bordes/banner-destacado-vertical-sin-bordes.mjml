<mjml>
  <mj-head>
    <mj-include path="@partials/fonts.mjml" />
    <mj-include path="@partials/colors.mjml" />
    <!-- Mobile hasta 599px, como la referencia. MJML emite el corte de
         desktop en (breakpoint) y el de mobile en (breakpoint - 1). -->
    <mj-breakpoint width="600px" />
    <!-- Mejora visual para ajustar espaciados y centrar el bloque en mobile;
         no es un requisito: el layout base funciona sin este <mj-style>. -->
    <mj-style>
      @media only screen and (max-width:599px) {
        .banner-destacado-vertical-sin-bordes-marco > table > tbody > tr > td {
          padding-left: 16px !important;
          padding-right: 16px !important;
        }
        .banner-destacado-vertical-sin-bordes-icono-img { padding: 16px 20px 0px 20px !important; }
        .banner-destacado-vertical-sin-bordes-titulo { padding: 12px 20px 8px 20px !important; }
        .banner-destacado-vertical-sin-bordes-cuerpo { padding: 0px 20px 16px 20px !important; }
        .banner-destacado-vertical-sin-bordes-titulo div,
        .banner-destacado-vertical-sin-bordes-cuerpo div { text-align: center !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body mj-class="bg-gris-claro" width="600px">
    <!-- 40px laterales = los 24px de margen del contenedor de la referencia
         + 16px de padding: la caja mide 520px dentro de los 600. En mobile
         bajan a 16px por la media query. -->
    <mj-wrapper
      mj-class="bg-blanco"
      css-class="banner-destacado-vertical-sin-bordes-marco"
      padding="0px 40px"
    >
      <!-- El borde y el radio van en el mj-section porque envuelven a las dos
           columnas; un mj-column solo alcanzaría a una. -->
      <mj-section
        mj-class="bg-celeste-claro borde-celeste-claro"
        border-radius="12px"
        padding="0px"
        text-align="left"
      >
        <!-- Sin mj-group: por debajo del breakpoint las columnas se apilan
             solas y la media query las centra, como la referencia. Los anchos
             van en px explícitos porque MJML reparte 50/50 al que no lo
             declara. -->
        <!-- 124px = los 104px que declara la celda de la referencia + sus 20px
             de padding izquierdo. Medido sobre la referencia en el navegador. -->
        <mj-column
          css-class="banner-destacado-vertical-sin-bordes-icono"
          width="124px"
          padding="0px"
          vertical-align="middle"
        >
          <mj-image
            css-class="banner-destacado-vertical-sin-bordes-icono-img"
            src="https://bcp-mid-stage13-res.adobe-campaign.com/res/tracking/f2d9855c0b2c1f83f4228ab86be22acb.png"
            alt="icono"
            width="100px"
            align="center"
            padding="16px 12px 16px 12px"
          />
        </mj-column>
        <mj-column
          css-class="banner-destacado-vertical-sin-bordes-texto"
          width="394px"
          padding="0px"
          vertical-align="middle"
        >
          <mj-text
            mj-class="txt-azul"
            css-class="banner-destacado-vertical-sin-bordes-titulo"
            align="left"
            font-family="Flexo, Arial, Helvetica, sans-serif"
            font-weight="700"
            font-size="20px"
            line-height="28px"
            padding="16px 12px 8px 12px"
          >
            Participa por 1 Kit Apple
          </mj-text>
          <mj-text
            mj-class="txt-azul-oscuro"
            css-class="banner-destacado-vertical-sin-bordes-cuerpo"
            align="left"
            font-family="Flexo, Arial, Helvetica, sans-serif"
            font-weight="400"
            font-size="16px"
            line-height="24px"
            padding="0px 12px 16px 12px"
          >
            Recuerda que también puedes solicitar tu tarjeta desde la<span style="font-weight: 700"> App Banca Móvil BCP</span> en la sección <span style="font-weight: 700">Para Ti.</span>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
