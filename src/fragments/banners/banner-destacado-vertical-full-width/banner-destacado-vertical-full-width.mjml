<mjml>
  <mj-head>
    <mj-include path="@partials/fonts.mjml" />
    <mj-include path="@partials/colors.mjml" />
    <!-- Mobile hasta 599px, como la referencia. MJML emite el corte de
         desktop en (breakpoint) y el de mobile en (breakpoint - 1). -->
    <mj-breakpoint width="600px" />
    <!-- Mejora visual para ajustar espaciados y centrar el bloque en mobile;
         no es un requisito: el layout base funciona sin este <mj-style>. -->
    <mj-style>
      @media only screen and (max-width:599px) {
        .banner-destacado-vertical-full-width-icono-img { padding: 16px 20px 0px 20px !important; }
        .banner-destacado-vertical-full-width-titulo { padding: 12px 25px 8px 25px !important; }
        .banner-destacado-vertical-full-width-cuerpo { padding: 0px 25px 16px 25px !important; }
        .banner-destacado-vertical-full-width-titulo div,
        .banner-destacado-vertical-full-width-cuerpo div { text-align: center !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body mj-class="bg-gris-claro" width="600px">
    <!-- Sin laterales: la caja ocupa los 600px completos. -->
      <!-- El borde y el radio van en el mj-section porque así envuelven las
           dos columnas; el radio es 0px porque esta variante llega a los bordes. -->
      <mj-section
        mj-class="bg-celeste-claro borde-celeste-claro"
        border-radius="0px"
        padding="0px"
        text-align="left"
      >
        <!-- Sin mj-group: por debajo del breakpoint las columnas se apilan
             solas y la media query las centra, como la referencia. Los anchos
             van en px explícitos porque MJML reparte 50/50 al que no lo
             declara. -->
        <!-- 124px = los 104px que declara la celda de la referencia + sus 20px
             de padding izquierdo. Medido sobre la referencia en el navegador. -->
        <!-- En desktop el texto conserva 12px a la izquierda y lleva 25px a
             la derecha; con el borde suma 26px visibles. Al apilarse en
             mobile, ambos lados del texto pasan a 25px para equilibrarlo. -->
        <mj-column
          css-class="banner-destacado-vertical-full-width-icono"
          width="124px"
          padding="0px"
          vertical-align="middle"
        >
          <mj-image
            css-class="banner-destacado-vertical-full-width-icono-img"
            src="https://bcp-mid-stage13-res.adobe-campaign.com/res/tracking/f2d9855c0b2c1f83f4228ab86be22acb.png"
            alt="icono"
            width="100px"
            align="center"
            padding="16px 12px 16px 12px"
          />
        </mj-column>
        <mj-column
          css-class="banner-destacado-vertical-full-width-texto"
          width="474px"
          padding="0px"
          vertical-align="middle"
        >
          <mj-text
            mj-class="txt-azul"
            css-class="banner-destacado-vertical-full-width-titulo"
            align="left"
            font-family="Flexo, Arial, Helvetica, sans-serif"
            font-weight="700"
            font-size="20px"
            line-height="28px"
            padding="16px 25px 8px 12px"
          >
            Participa por 1 Kit Apple
          </mj-text>
          <mj-text
            mj-class="txt-azul-oscuro"
            css-class="banner-destacado-vertical-full-width-cuerpo"
            align="left"
            font-family="Flexo, Arial, Helvetica, sans-serif"
            font-weight="400"
            font-size="16px"
            line-height="24px"
            padding="0px 25px 16px 12px"
          >
            Recuerda que también puedes solicitar tu tarjeta desde la<span style="font-weight: 700"> App Banca Móvil BCP</span> en la sección <span style="font-weight: 700">Para Ti.</span>
          </mj-text>
        </mj-column>
      </mj-section>
  </mj-body>
</mjml>
